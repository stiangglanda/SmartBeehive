            ]
        ]
    },
    {
        "id": "96bf3ce418c8f3aa",
        "type": "influxdb in",
        "z": "f6f2187d.f17ca8",
        "influxdb": "57299f233d88ecb5",
        "name": "",
        "query": "from(bucket: \"beehive_data\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"sensoren\")\n  |> filter(fn: (r) => r._field == \"weight\" or r._field == \"temp_stock\" or r._field == \"temp_brut\" or r._field == \"humidity\" or r._field == \"activity\")\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)\n  |> pivot(rowKey:[\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"weight\", \"temp_stock\", \"temp_brut\", \"humidity\", \"activity\"])",
        "rawOutput": false,
        "precision": "",
        "retentionPolicy": "",
        "org": "SmartBeehive",
        "x": 530,
        "y": 580,
        "wires": [
            [
                "5bc17256bc77cfaa"
            ]
        ]
    },
    {
        "id": "5bc17256bc77cfaa",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "DiagrammFormat",
        "func": "var data = msg.payload;\nvar formatted = [];\nfor (var i = 0; i < data.length; i++) {\n    var date = new Date(data[i]._time);\n    var timeStr = date.getHours().toString().padStart(2, '0') + \":\" + \n                  date.getMinutes().toString().padStart(2, '0');\n                  \n    formatted.push({\n        time: timeStr,\n        weight: parseFloat(Number(data[i].weight || 0).toFixed(2)),\n        temp: parseFloat(Number(data[i].temp_stock || 0).toFixed(1)),\n        temp_brut: parseFloat(Number(data[i].temp_brut || 0).toFixed(1)),\n        humidity: parseFloat(Number(data[i].humidity || 0).toFixed(1)),\n        activity: parseFloat(Number(data[i].activity || 0).toFixed(0)) // NEU!\n    });\n}\nmsg.payload = formatted;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 770,
        "y": 580,
        "wires": [
            [
                "5bdc99d326a680bb"
            ]
        ]
