    {
        "id": "338fab4625520e05",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "InfluxFormat",
        "func": "// 1. SICHERHEITS-CHECK: Falls die Daten noch Text (String) sind, parsen wir sie hier manuell!\nif (typeof msg.payload === \"string\") {\n    try {\n        msg.payload = JSON.parse(msg.payload);\n    } catch (e) {\n        // Falls es kein gueltiges JSON ist, abbrechen\n        return null; \n    }\n}\n\n// 2. ECHTE NUMMERN ERZWINGEN (Floats):\n// Wir konvertieren die Werte explizit in Zahlen, damit InfluxDB sie niemals als Text abspeichert.\nmsg.payload = [\n    {\n        temp_stock: parseFloat(msg.payload.temp_stock),\n        temp_brut: parseFloat(msg.payload.temp_brut),\n        humidity: parseFloat(msg.payload.humidity),\n        weight: parseFloat(msg.payload.weight),\n        activity: parseFloat(msg.payload.activity)\n    },\n    {\n        sensor_id: \"beehive_01\"\n    }\n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 690,
        "y": 400,
        "wires": [
            [
                "a5beb51e40c20598"
            ]
        ]
    },
    {
        "id": "dc264c26b98789eb",
        "type": "inject",
        "z": "f6f2187d.f17ca8",
        "name": "",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "300",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 310,
